{
  "name": "abf-blueprint-ts",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "node --test \"packages/*/dist/test/**/*.test.js\" \"scripts/release/test/*.test.mjs\" \"website/test/*.test.mjs\"",
    "clean": "tsc -b --clean",
    "vsix": "npm run build && npm run package -w abfc-vscode",
    "release:exe": "node scripts/release/build-exe.mjs",
    "release:installer": "node scripts/release/build-installer.mjs",
    "release:inspect": "node scripts/release/inspect.mjs",
    "release:smoke": "node scripts/release/smoke-backend.mjs",
    "release:fetch": "node scripts/release/fetch-pins.mjs",
    "release:version": "node scripts/release/set-version.mjs",
    "release:npm": "node scripts/release/pack-npm.mjs",
    "release:scan": "node scripts/release/scan-artifacts.mjs",
    "release:github": "node scripts/release/stage-github.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@typescript-eslint/parser": "8.72.1",
    "@typescript-eslint/rule-tester": "8.72.1",
    "eslint": "10.14.0",
    "typescript": "6.0.3"
  }
}
