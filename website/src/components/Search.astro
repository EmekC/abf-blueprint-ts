---
// Replaces Starlight's search box. Two result groups: a fuzzy match over search-index.json (nodes, runtime API, error codes, page titles;
// matcher in lib/fuzzy.mjs, the same name tiers as the editor's completion list) and Pagefind full-text results (built site only).
import { Icon } from '@astrojs/starlight/components';
---

<abfc-search class={Astro.props.class} data-base={import.meta.env.BASE_URL}>
  <button data-open-modal disabled aria-label="Search" aria-keyshortcuts="Control+K">
    <Icon name="magnifier" />
    <span class="sl-hidden md:sl-block" aria-hidden="true">Search</span>
    <kbd class="sl-hidden md:sl-flex" style="display: none">
      <kbd>Ctrl</kbd><kbd>K</kbd>
    </kbd>
  </button>

  <dialog style="padding: 0" aria-label="Search">
    <div class="dialog-frame sl-flex">
      <button data-close-modal class="sl-flex md:sl-hidden">Cancel</button>
      <input type="search" placeholder="Search nodes, API, errors and pages" aria-label="Search" autocomplete="off" spellcheck="false" />
      <div class="abfc-results" aria-live="polite">
        <section data-group="nodes" hidden>
          <h2>Nodes, API and errors</h2>
          <ul id="abfc-search-nodes"></ul>
        </section>
        <section data-group="pages" hidden>
          <h2>Pages</h2>
          <ul id="abfc-search-pages"></ul>
        </section>
        <p class="abfc-hint" data-message></p>
      </div>
    </div>
  </dialog>
</abfc-search>

{/* Inlined so the shortcut hint matches the platform from the first paint (same approach as Starlight's own search). */}
<script is:inline>
  (() => {
    const openBtn = document.querySelector("button[data-open-modal]");
    const shortcut = openBtn?.querySelector("kbd");
    if (!openBtn || !(shortcut instanceof HTMLElement)) return;
    const platformKey = shortcut.querySelector("kbd");
    if (platformKey && /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
      platformKey.textContent = "⌘";
      openBtn.setAttribute("aria-keyshortcuts", "Meta+K");
    }
    shortcut.style.display = "";
  })();
</script>

<script>
  // @ts-expect-error - plain JavaScript module without types.
  import { search } from "../../lib/fuzzy.mjs";
  // @ts-expect-error - virtual module provided by Starlight.
  import { pagefindUserConfig } from "virtual:starlight/pagefind-config";

  interface Entry {
    kind: "node" | "runtime" | "error" | "page";
    title: string;
    tsName: string;
    qualified: string;
    text?: string;
    module?: string;
    doc?: 1;
    blocked?: 1;
    url: string;
  }

  const KIND_LABEL: Record<Entry["kind"], string> = { node: "node", runtime: "API", error: "error", page: "page" };
  const NO_MATCH =
    "No match. The node reference lists the functions of one generated stub set; in VS Code, completion finds any node by its name.";
  const NO_FULL_TEXT =
    "Full-text search works in the built site (npm run build && npm run preview).";

  class AbfcSearch extends HTMLElement {
    constructor() {
      super();
      const base = (this.dataset.base ?? "/").replace(/\/?$/, "/");
      const openBtn = this.querySelector<HTMLButtonElement>("button[data-open-modal]")!;
      const closeBtn = this.querySelector<HTMLButtonElement>("button[data-close-modal]")!;
      const dialog = this.querySelector("dialog")!;
      const frame = this.querySelector(".dialog-frame")!;
      const input = this.querySelector<HTMLInputElement>("input")!;
      const nodesGroup = this.querySelector<HTMLElement>('[data-group="nodes"]')!;
      const pagesGroup = this.querySelector<HTMLElement>('[data-group="pages"]')!;
      const nodesList = this.querySelector<HTMLUListElement>("#abfc-search-nodes")!;
      const pagesList = this.querySelector<HTMLUListElement>("#abfc-search-pages")!;
      const message = this.querySelector<HTMLElement>("[data-message]")!;

      let entries: Entry[] | undefined;
      let indexRequest: Promise<Entry[]> | undefined;
      let pagefind: any;
      let pagefindRequest: Promise<any> | undefined;
      let generation = 0;
      let timer: ReturnType<typeof setTimeout> | undefined;

      const loadIndex = (): Promise<Entry[]> => {
        indexRequest ??= fetch(base + "search-index.json")
          .then((r) => r.json())
          .then((data: { entries: Entry[] }) => (entries = data.entries))
          .catch(() => (entries = []));
        return indexRequest;
      };

      const loadPagefind = (): Promise<any> => {
        pagefindRequest ??= (async () => {
          try {
            const pf = await import(/* @vite-ignore */ base + "pagefind/pagefind.js");
            await pf.options({ ...pagefindUserConfig, baseUrl: base });
            await pf.init();
            return (pagefind = pf);
          } catch {
            return null;
          }
        })();
        return pagefindRequest;
      };

      const link = (href: string): HTMLAnchorElement => {
        const a = document.createElement("a");
        a.href = href;
        return a;
      };

      const renderEntry = (e: Entry): HTMLLIElement => {
        const li = document.createElement("li");
        const a = link(e.url);
        const title = document.createElement("b");
        title.textContent = e.title;
        a.append(title);
        if (e.qualified !== "") {
          const code = document.createElement("code");
          code.textContent = e.qualified;
          a.append(" ", code);
        }
        const kind = document.createElement("small");
        kind.textContent = KIND_LABEL[e.kind];
        a.append(" ", kind);
        if (e.blocked) {
          const blocked = document.createElement("small");
          blocked.textContent = "blocked";
          a.append(" ", blocked);
        }
        const summary = e.text ? e.text : e.module ? `${e.module} module` : "";
        if (summary !== "") {
          const span = document.createElement("span");
          span.textContent = summary;
          a.append(span);
        }
        li.append(a);
        return li;
      };

      const renderFullText = async (hit: any): Promise<HTMLLIElement> => {
        const data = await hit.data();
        const li = document.createElement("li");
        const a = link(data.url);
        const title = document.createElement("b");
        title.textContent = data.meta?.title ?? data.url;
        const span = document.createElement("span");
        span.innerHTML = data.excerpt; // Pagefind returns the excerpt with <mark> around the matches and escapes everything else.
        a.append(title, span);
        li.append(a);
        return li;
      };

      const links = () => Array.from(this.querySelectorAll<HTMLAnchorElement>(".abfc-results a"));
      const select = (next: number) => {
        const all = links();
        if (all.length === 0) return;
        const index = (next + all.length) % all.length;
        all.forEach((a, i) => a.toggleAttribute("data-selected", i === index));
        all[index].scrollIntoView({ block: "nearest" });
      };

      // `pending`: a full-text search is still to come; `note`: why full-text results are missing.
      let pending = false;
      let note = "";
      const refresh = () => {
        const hasNodes = nodesList.children.length > 0;
        const hasPages = pagesList.children.length > 0;
        nodesGroup.hidden = !hasNodes;
        pagesGroup.hidden = !hasPages;
        const parts: string[] = [];
        if (input.value.trim() !== "") {
          if (!hasNodes && !hasPages && !pending) parts.push(NO_MATCH);
          if (note !== "") parts.push(note);
        }
        message.textContent = parts.join(" ");
        if (links().length > 0 && this.querySelector("a[data-selected]") === null) select(0);
      };

      const run = async () => {
        const mine = ++generation;
        const query = input.value;
        clearTimeout(timer);
        nodesList.replaceChildren();
        pagesList.replaceChildren();
        note = "";
        pending = query.trim().length >= 2;
        if (query.trim() === "") {
          refresh();
          return;
        }
        const index = entries ?? (await loadIndex());
        if (mine !== generation) return;
        for (const e of search(index, query, 12) as Entry[]) nodesList.append(renderEntry(e));
        refresh();
        if (!pending) return;

        timer = setTimeout(async () => {
          if (mine !== generation) return;
          const pf = pagefind ?? (await loadPagefind());
          if (mine !== generation) return;
          if (pf === null || pf === undefined) {
            pending = false;
            note = NO_FULL_TEXT;
            refresh();
            return;
          }
          const found = await pf.search(query);
          const items = await Promise.all(found.results.slice(0, 8).map(renderFullText));
          if (mine !== generation) return;
          pending = false;
          pagesList.replaceChildren(...items);
          refresh();
        }, 150);
      };

      const openModal = (event?: Event) => {
        dialog.showModal();
        document.body.toggleAttribute("data-search-modal-open", true);
        input.focus();
        input.select();
        void loadIndex();
        event?.stopPropagation();
      };
      const closeModal = () => dialog.close();

      openBtn.addEventListener("click", openModal);
      openBtn.disabled = false;
      closeBtn.addEventListener("click", closeModal);
      input.addEventListener("input", () => void run());
      dialog.addEventListener("close", () => document.body.toggleAttribute("data-search-modal-open", false));
      // A click on a result or outside the dialog frame closes it.
      dialog.addEventListener("click", (e) => {
        const target = e.target as Node;
        if ((target instanceof Element && target.closest("a") !== null) || !frame.contains(target)) closeModal();
      });

      dialog.addEventListener("keydown", (e) => {
        if (e.key === "ArrowDown" || e.key === "ArrowUp") {
          const all = links();
          const current = all.findIndex((a) => a.hasAttribute("data-selected"));
          select(current + (e.key === "ArrowDown" ? 1 : -1));
          e.preventDefault();
        } else if (e.key === "Enter") {
          const current = this.querySelector<HTMLAnchorElement>("a[data-selected]");
          if (current !== null) {
            e.preventDefault();
            current.click();
          }
        }
      });

      window.addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === "k") {
          dialog.open ? closeModal() : openModal();
          e.preventDefault();
          return;
        }
        const target = e.target as HTMLElement | null;
        const typing = target !== null && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName));
        if (e.key === "/" && !typing && !e.metaKey && !e.ctrlKey && !e.altKey && !dialog.open) {
          openModal();
          e.preventDefault();
        }
      });
    }
  }
  customElements.define("abfc-search", AbfcSearch);
</script>

<style>
  @layer starlight.core {
    abfc-search {
      display: contents;
    }
    button[data-open-modal] {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      border: 0;
      background-color: transparent;
      color: var(--sl-color-gray-1);
      cursor: pointer;
      height: 2.5rem;
      font-size: var(--sl-text-xl);
    }

    @media (min-width: 50rem) {
      button[data-open-modal] {
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 0.5rem;
        padding-inline-start: 0.75rem;
        padding-inline-end: 0.5rem;
        background-color: var(--sl-color-black);
        color: var(--sl-color-gray-2);
        font-size: var(--sl-text-sm);
        width: 100%;
        max-width: 22rem;
      }
      button[data-open-modal]:hover {
        border-color: var(--sl-color-gray-2);
        color: var(--sl-color-white);
      }
      button[data-open-modal] > :last-child {
        margin-inline-start: auto;
      }
    }

    button > kbd {
      border-radius: 0.25rem;
      font-size: var(--sl-text-2xs);
      gap: 0.25em;
      padding-inline: 0.375rem;
      background-color: var(--sl-color-gray-6);
    }
    kbd {
      font-family: var(--__sl-font);
    }

    dialog {
      margin: 0;
      background-color: var(--sl-color-gray-6);
      border: 1px solid var(--sl-color-gray-5);
      width: 100%;
      max-width: 100%;
      height: 100%;
      max-height: 100%;
      box-shadow: var(--sl-shadow-lg);
    }
    dialog[open] {
      display: flex;
    }
    dialog::backdrop {
      background-color: var(--sl-color-backdrop-overlay);
      -webkit-backdrop-filter: blur(0.25rem);
      backdrop-filter: blur(0.25rem);
    }

    .dialog-frame {
      position: relative;
      overflow: auto;
      flex-direction: column;
      flex-grow: 1;
      gap: 1rem;
      padding: 1rem;
    }

    button[data-close-modal] {
      position: absolute;
      z-index: 1;
      align-items: center;
      align-self: flex-end;
      height: 3rem;
      padding: 0.25rem;
      border: 0;
      background: transparent;
      cursor: pointer;
      color: var(--sl-color-text-accent);
    }

    input[type="search"] {
      width: calc(100% - 5rem);
      padding: 0.75rem 1rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.5rem;
      background-color: var(--sl-color-black);
      color: var(--sl-color-white);
      font-size: var(--sl-text-base);
    }
    input[type="search"]:focus {
      outline: none;
      border-color: var(--sl-color-accent);
    }

    .abfc-results section {
      margin-bottom: 1rem;
    }
    .abfc-results h2 {
      margin: 0 0 0.5rem;
      color: var(--sl-color-gray-3);
      font-size: var(--sl-text-xs);
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }
    .abfc-results ul {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .abfc-results a {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.1rem 0.6rem;
      padding: 0.6rem 0.9rem;
      border-radius: 0.375rem;
      background-color: var(--sl-color-black);
      color: var(--sl-color-gray-2);
      text-decoration: none;
    }
    .abfc-results a:hover,
    .abfc-results a[data-selected] {
      outline: 1px solid var(--sl-color-accent-high);
      background-color: var(--sl-color-accent-low);
    }
    .abfc-results a b {
      color: var(--sl-color-white);
    }
    .abfc-results a small {
      color: var(--sl-color-gray-3);
      font-size: var(--sl-text-2xs);
      text-transform: uppercase;
    }
    .abfc-results a span {
      flex-basis: 100%;
      font-size: var(--sl-text-sm);
      overflow-wrap: anywhere;
    }
    .abfc-results mark {
      background-color: transparent;
      color: var(--sl-color-white);
      font-weight: 600;
    }
    .abfc-hint {
      color: var(--sl-color-gray-3);
      font-size: var(--sl-text-sm);
    }

    @media (min-width: 50rem) {
      dialog {
        margin: 4rem auto auto;
        border-radius: 0.5rem;
        width: 90%;
        max-width: 40rem;
        height: max-content;
        min-height: 15rem;
        max-height: calc(100% - 8rem);
      }
      .dialog-frame {
        padding: 1.5rem;
      }
      input[type="search"] {
        width: 100%;
      }
    }
  }
</style>

<style is:global>
  @layer starlight.core {
    [data-search-modal-open] {
      overflow: hidden;
    }
  }
</style>
