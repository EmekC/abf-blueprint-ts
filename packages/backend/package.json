{
  "name": "@abfc/backend",
  "version": "1.0.0",
  "description": "Backend adapter of abfc: talks to the Mod Editor's Python bridge to apply, compile and publish Blueprints.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmekC/abf-blueprint-ts.git",
    "directory": "packages/backend"
  },
  "homepage": "https://github.com/EmekC/abf-blueprint-ts#readme",
  "bugs": {
    "url": "https://github.com/EmekC/abf-blueprint-ts/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts"
  ],
  "dependencies": {
    "@abfc/ir": "1.0.0",
    "@abfc/env": "1.0.0"
  },
  "devDependencies": {
    "@abfc/compiler": "1.0.0"
  }
}
