{
  "name": "@abfc/testkit",
  "version": "1.0.0",
  "description": "Test kit of abfc: runs mod tests against the Blueprint graph IR.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmekC/abf-blueprint-ts.git",
    "directory": "packages/testkit"
  },
  "homepage": "https://github.com/EmekC/abf-blueprint-ts#readme",
  "bugs": {
    "url": "https://github.com/EmekC/abf-blueprint-ts/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./runner": {
      "types": "./dist/src/runner.d.ts",
      "default": "./dist/src/runner.js"
    }
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts"
  ],
  "dependencies": {
    "@abfc/ir": "1.0.0"
  }
}
