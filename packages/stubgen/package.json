{
  "name": "@abfc/stubgen",
  "version": "1.0.0",
  "description": "Stub generator of abfc: turns exported Blueprint metadata into TypeScript declarations.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmekC/abf-blueprint-ts.git",
    "directory": "packages/stubgen"
  },
  "homepage": "https://github.com/EmekC/abf-blueprint-ts#readme",
  "bugs": {
    "url": "https://github.com/EmekC/abf-blueprint-ts/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "data"
  ],
  "dependencies": {
    "@abfc/ir": "1.0.0",
    "@abfc/env": "1.0.0"
  }
}
