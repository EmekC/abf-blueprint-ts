{
  "name": "@abfc/runtime",
  "version": "1.0.0",
  "description": "Runtime declarations and decorators for abfc mod sources.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmekC/abf-blueprint-ts.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/EmekC/abf-blueprint-ts#readme",
