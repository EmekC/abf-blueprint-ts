{
  "name": "@abfc/eslint-plugin",
  "version": "1.0.0",
  "description": "ESLint rules of abfc for Blueprint-targeted TypeScript.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmekC/abf-blueprint-ts.git",
    "directory": "packages/eslint-plugin"
  },
  "homepage": "https://github.com/EmekC/abf-blueprint-ts#readme",
  "bugs": {
    "url": "https://github.com/EmekC/abf-blueprint-ts/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts"
  ],
  "dependencies": {
    "@typescript-eslint/utils": "8.72.1"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  }
}
